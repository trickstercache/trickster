
listeners:
  default:
    address: 127.0.0.1
    port: %d
  metrics:
    address: 127.0.0.1
    port: %d
  mgmt:
    address: 127.0.0.1
    port: %d
logging:
  log_level: warn
caches:
  mem1:
    provider: memory
backends:
  prom-noprobe:
    provider: prometheus
    origin_url: %s
    cache_name: mem1
  alb-floor1:
    provider: alb
    alb:
      mechanism: tsm
      output_format: prometheus
      healthy_floor: 1
      pool:
        - prom-noprobe
